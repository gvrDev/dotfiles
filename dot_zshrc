# .zshrc - Clean, high-performance Zsh configuration

# Fallback to systemd user SSH agent socket if available
if [[ -z "$SSH_AUTH_SOCK" && -S "${XDG_RUNTIME_DIR}/ssh-agent.socket" ]]; then
  export SSH_AUTH_SOCK="${XDG_RUNTIME_DIR}/ssh-agent.socket"
fi

# Early Guard: Non-interactive short-circuit (0ms overhead for subshells/scripts)
[[ -o interactive ]] || return 0

# ------------------------------------------------------------------------------
# 1. Environment & PATH
# ------------------------------------------------------------------------------
export EDITOR="nvim"
export VISUAL="nvim"

typeset -U path PATH
path=(
  "$HOME/.local/bin"
  "$HOME/.local/lib"
  "$HOME/go/bin"
  "$HOME/.cargo/bin"
  "$HOME/.local/share/mise/shims"
  "$HOME/.npm-global/bin"
  "$HOME/.bun/bin"
  /home/linuxbrew/.linuxbrew/bin
  /opt/homebrew/bin
  $path
)
export PATH

# Completion search paths
fpath=(
  "$HOME/.local/share/zsh/site-functions"
  "${XDG_CACHE_HOME:-$HOME/.cache}/zsh/completions"
  $fpath
)

# ------------------------------------------------------------------------------
# 2. History Settings
# ------------------------------------------------------------------------------
HISTFILE="${XDG_STATE_HOME:-$HOME/.local/state}/zsh/history"
[[ -d "${HISTFILE:h}" ]] || mkdir -p "${HISTFILE:h}"
HISTSIZE=50000
SAVEHIST=50000

setopt EXTENDED_HISTORY SHARE_HISTORY HIST_IGNORE_ALL_DUPS HIST_IGNORE_SPACE HIST_SAVE_NO_DUPS

# ------------------------------------------------------------------------------
# 3. Tool Integrations (Cached scripts)
# ------------------------------------------------------------------------------
_zcache="${XDG_CACHE_HOME:-$HOME/.cache}/zsh"
[[ -r "$_zcache/atuin.zsh" ]]  && source "$_zcache/atuin.zsh"
[[ -r "$_zcache/zoxide.zsh" ]] && source "$_zcache/zoxide.zsh"
[[ -r "$_zcache/fzf.zsh" ]]    && source "$_zcache/fzf.zsh"

# FZF search defaults
export FZF_DEFAULT_OPTS='--height 40% --layout=reverse --border --inline-info'
export FZF_CTRL_T_OPTS='--preview "bat --style=numbers --color=always --line-range :50 {} 2>/dev/null || cat {} 2>/dev/null"'
export FZF_ALT_C_OPTS='--preview "eza --tree --level=2 --color=always {} 2>/dev/null || ls {} 2>/dev/null"'

# ------------------------------------------------------------------------------
# 4. Native Vi Mode (Instant 0ms, block/beam cursor)
# ------------------------------------------------------------------------------
bindkey -v
export KEYTIMEOUT=1

function zle-keymap-select() {
  if [[ $KEYMAP == vicmd ]]; then
    print -n '\e[2 q'  # Block cursor in normal mode
  else
    print -n '\e[6 q'  # Beam cursor in insert mode
  fi
}
zle -N zle-keymap-select

function zle-line-init() {
  print -n '\e[6 q'    # Beam cursor on prompt start
}
zle -N zle-line-init

# ------------------------------------------------------------------------------
# 5. Autosuggestions Settings
# ------------------------------------------------------------------------------
ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE=50
ZSH_AUTOSUGGEST_USE_ASYNC=1
ZSH_AUTOSUGGEST_STRATEGY=(history completion)

# ------------------------------------------------------------------------------
# 6. Antidote Static Plugin Bundle
# ------------------------------------------------------------------------------
zsh_plugins="${ZDOTDIR:-$HOME}/.zsh_plugins"
if [[ ! -s "${zsh_plugins}.zsh" || "${zsh_plugins}.txt" -nt "${zsh_plugins}.zsh" ]]; then
  source "${ZDOTDIR:-$HOME}/.antidote/antidote.zsh"
  antidote bundle <"${zsh_plugins}.txt" >|"${zsh_plugins}.zsh"
fi
source "${zsh_plugins}.zsh"

# ------------------------------------------------------------------------------
# 7. Keybindings
# ------------------------------------------------------------------------------
bindkey -M viins '^r' atuin-search-viins
bindkey -M vicmd '^r' atuin-search-vicmd
bindkey -M viins '^[[A' atuin-up-search-viins
bindkey -M vicmd '^[[A' atuin-up-search-vicmd
bindkey -M vicmd 'k' atuin-up-search-vicmd
bindkey -M viins '^f' autosuggest-accept
bindkey -M viins '^F' autosuggest-accept

# ------------------------------------------------------------------------------
# 8. Prompt
# ------------------------------------------------------------------------------
setopt PROMPT_SUBST
PROMPT='%F{39}%~%f %(?.%F{76}.%F{196})❯%f '
