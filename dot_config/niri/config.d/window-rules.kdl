window-rule {
    match app-id=r#"wezterm$"#
    open-on-workspace "1"
    open-maximized true
}
window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}

window-rule {
    match app-id=r#"chromium"#
    open-on-workspace "2"
    open-maximized true
}
window-rule {
    match app-id=r#"brave"#
    open-on-workspace "3"
    open-maximized true
}
window-rule {
    match app-id=r#"firefox"# title=r#"^Picture[- ]in[- ][Pp]icture$"#
    match app-id=r#"brave"# title=r#"^Picture[- ]in[- ][Pp]icture$"#
    match app-id=r#"chromium"# title=r#"^Picture[- ]in[- ][Pp]icture$"#
    open-floating true
}

window-rule {
    match app-id="steam$" title=r#"^notificationtoasts_\d+_desktop$"#
    default-floating-position x=10 y=10 relative-to="bottom-right"
    open-floating true
}
window-rule {
    match app-id=r#"^steam$"#
    exclude title="^Steam$"
    exclude title=r#"^notificationtoasts_\d+_desktop$"#
    open-floating true
}
window-rule {
    match app-id=r#"^steam$"# title="^Steam$"
    open-on-workspace "4"
    open-maximized true
}


window-rule {
    match app-id=r#"^Emulator$"#
    open-floating true
}

window-rule {
    match app-id=r#"^Slack"#
    open-on-workspace "5"
    open-maximized true
}
window-rule {
    match app-id=r#"discord"#
    open-on-workspace "7"
    open-maximized true
}
window-rule {
    match app-id=r#"bitwarden$"#
    open-on-workspace "8"
    block-out-from "screen-capture"
    open-maximized true
}

window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}
